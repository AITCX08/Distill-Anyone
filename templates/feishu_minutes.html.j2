<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<style>
  @page { size: A4; margin: 2cm 1.8cm; }
  body {
    font-family: "PingFang SC", "Heiti SC", "Songti SC", "Noto Sans CJK SC", sans-serif;
    color: #1f2329; font-size: 11pt; line-height: 1.75;
  }
  h1 {
    font-size: 16pt; font-weight: 700; color: #1f2329;
    border-bottom: 2px solid #e5e6eb; padding-bottom: 6px; margin: 22px 0 12px;
  }
  h1:first-child { margin-top: 0; }
  blockquote {
    margin: 0 0 16px; padding: 12px 16px; background: #f7f8fa;
    border-left: 3px solid #c9cdd4; border-radius: 4px;
    color: #4e5969; font-size: 10pt;
  }
  blockquote p { margin: 2px 0; }
  ul { margin: 6px 0; padding-left: 22px; }
  li { margin: 3px 0; }
  li strong { color: #1f2329; }
  li.todo { list-style: none; margin-left: -18px; }
  li.todo.done { color: #86909c; text-decoration: line-through; }
  p { margin: 6px 0; }
  /* 文字记录里说话人加粗行 */
  p strong { color: #245bdb; }
</style>
</head>
<body>
{{ body | safe }}
</body>
</html>
